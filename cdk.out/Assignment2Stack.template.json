    "BucketNotificationsHandler050a0587b7544547bf325f094a3db834RoleB6FB88EC"
   ],
   "Metadata": {
    "aws:cdk:path": "Assignment2Stack/BucketNotificationsHandler050a0587b7544547bf325f094a3db834/Resource"
   }
